# The Slack MCP server. Holds the Bright Data credential.
#
# Runs as its own user (kpi-mcp) so that the weekly job -- which runs as a
# DIFFERENT user -- cannot read this process's memory, environment or files.
# That uid split is what makes "the client holds no credentials" structural
# rather than a convention.

[Unit]
Description=KPI tracker Slack MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=kpi-mcp
Group=kpi-mcp
WorkingDirectory=/opt/kpi-tracker

Environment=KPI_SECRET_BACKEND=aws
Environment=AWS_REGION=us-east-1
Environment=KPI_SLACK_SECRET_ID=kpi/slack-bot-token
Environment=KPI_SLACK_DESTINATION=C0BV21PC28P
Environment=KPI_SLACK_STATE_PATH=/var/lib/kpi-mcp/slack-sent.json
ExecStart=/opt/kpi-tracker/.venv/bin/python -m kpi_mcp.slack_server --host 127.0.0.1 --port 8802

Restart=always
RestartSec=5s

# --- hardening -----------------------------------------------------------
# NoNewPrivileges  : this process can never gain privileges via setuid binaries.
# ProtectSystem    : /usr, /boot and /etc are read-only to it.
# ProtectHome      : it cannot see /home, /root or /run/user at all.
# PrivateTmp       : its own /tmp, so nothing else can read files it writes there.
# ProtectProc      : it cannot see other users' processes in /proc -- which also
#                    means it cannot be used to snoop on anything else.
# CapabilityBoundingSet= (empty) : no Linux capabilities whatsoever.
# MemoryDenyWriteExecute : blocks a common code-injection technique.
# SystemCallFilter : only ordinary system calls; no raw sockets, no kernel modules.
NoNewPrivileges=true
ProtectSystem=strict
# The only path it may write: its one-report-per-week record.
StateDirectory=kpi-mcp
ReadWritePaths=/var/lib/kpi-mcp
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
