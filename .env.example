# LOCAL DEVELOPMENT ONLY. Never put this file on the VM.
#
# On EC2 the MCP servers read their credentials from AWS Secrets Manager and
# nothing is stored on disk. This file exists so you can run the servers on a
# laptop without an AWS account.
#
# The CLIENT never needs any of these. `kpi-tracker check` FAILS if it finds
# BRIGHTDATA_API_TOKEN or SLACK_BOT_TOKEN in its own environment, because that
# would mean the client holds a credential again.

# 'env' reads the variables below. 'aws' reads AWS Secrets Manager.
KPI_SECRET_BACKEND=env

# --- kpi-linkedin server -------------------------------------------------
# With backend=env, KPI_LINKEDIN_SECRET_ID names an ENV VAR to read.
# With backend=aws, it names a Secrets Manager secret.
KPI_LINKEDIN_SECRET_ID=BRIGHTDATA_API_TOKEN
BRIGHTDATA_API_TOKEN=

# --- kpi-slack server ----------------------------------------------------
KPI_SLACK_SECRET_ID=SLACK_BOT_TOKEN
SLACK_BOT_TOKEN=
# The destination is server-side on purpose: nothing else on the machine can
# redirect the weekly report.
KPI_SLACK_DESTINATION=C0BV21PC28P
KPI_SLACK_STATE_PATH=./data/slack-sent.json
