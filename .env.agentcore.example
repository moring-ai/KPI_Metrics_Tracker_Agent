# The env contract for the AgentCore / AICP deployment.
#
# On EC2 the tokens live in two separate MCP server processes the client cannot
# read. AICP does not support MCP today, so here the SAME servers run in-process
# and this container holds both tokens as environment variables. That is a real
# reduction in isolation, accepted because the platform cannot express the
# alternative yet -- see src/agent/graph.py for the full reasoning.

# ---- AICP deploy form: the non-secret env box (one line each) --------------
KPI_CONFIG_PATH=config.json
KPI_SECRET_BACKEND=env
KPI_LINKEDIN_SECRET_ID=BRIGHTDATA_API_TOKEN
KPI_SLACK_SECRET_ID=SLACK_BOT_TOKEN
KPI_SLACK_DESTINATION=C0BV21PC28P
# Ephemeral in a container; see README "Ephemeral state" before relying on it.
KPI_SLACK_STATE_PATH=/tmp/kpi-slack-sent.json
# false makes every invocation a dry run -- use it for the first deploy.
AGENT_SEND=true

# ---- AICP deploy form: the SECRET box (Secrets Manager JSON) ---------------
# {
#   "BRIGHTDATA_API_TOKEN": "...",
#   "SLACK_BOT_TOKEN": "xoxb-..."
# }

# ---- injected by AICP, not set by you -------------------------------------
# OPENAI_BASE_URL / OPENAI_API_KEY / AGENT_MODEL
# This agent never calls a model, so the virtual key is injected and unspent.
